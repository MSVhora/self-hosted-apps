# -----------------------------------------------------------------------------
# HOUM Website Docker Environment Configuration
# -----------------------------------------------------------------------------

# Port on the host machine (bound to 127.0.0.1, Nginx proxies to it)
FORWARD_APP_PORT=3000

# Image tag from ghcr.io/msvhora/houm-web (short git SHA printed by deploy.sh, or latest)
HOUM_IMAGE_TAG=latest

# Public site origin (metadata, robots, sitemap)
SITE_URL=https://houm.picmix.in

# Shared secret for POST /api/revalidate (header: x-revalidate-secret)
REVALIDATE_SECRET=

# E-mail for the website forms (contact, enquiry, feedback, newsletter)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Must be the authenticated mailbox (GoDaddy rejects other senders)
MAIL_FROM=
# Where the form e-mails are delivered
FORM_TO_EMAIL=
