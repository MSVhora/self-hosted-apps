# ==============================================================================
# SOLIDTIME DOCKER & APPLICATION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOCKER COMPOSE CONFIGURATION
# ------------------------------------------------------------------------------
SOLIDTIME_IMAGE_TAG=latest
FORWARD_APP_PORT=8000

# ------------------------------------------------------------------------------
# 2. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
APP_NAME=Solidtime
APP_ENV=production
APP_DEBUG=false
# The public domain where Solidtime will be accessible
APP_URL=https://time.picmix.in

# ------------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHIC KEYS
# (Auto-generate after launching: docker compose run --rm scheduler php artisan self-host:generate-keys)
# ------------------------------------------------------------------------------
APP_KEY=
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 4. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=solidtime
DB_USERNAME=solidtime
# CHANGE THIS TO A STRONG PASSWORD
DB_PASSWORD=change_this_secure_database_password

# ------------------------------------------------------------------------------
# 5. QUEUE & SESSIONS
# ------------------------------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ------------------------------------------------------------------------------
# 6. MAIL / SMTP SETTINGS (For invitations & password resets)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# 7. REGISTRATION SETTINGS
# ------------------------------------------------------------------------------
# Set to false once your admin account is created if you don't want public signups
ALLOW_REGISTRATION=true
LOG_CHANNEL=stack
LOG_LEVEL=info
