# -----------------------------------------------------------------------------
# Life Game Docker Environment Configuration
# -----------------------------------------------------------------------------

# Port on the host machine (bound to 127.0.0.1, Nginx proxies to it)
FORWARD_APP_PORT=3017

# Image tag from ghcr.io/msvhora/life-game ("latest", a version like 1.0.0, or a short git SHA)
LIFE_GAME_IMAGE_TAG=latest

# Public address of the app (https). The session cookie is only sent over https when this starts with https.
PUBLIC_URL=https://life.yourdomain.com

# Database (the app connects to the db container; the password is generated by setup-life-game.sh)
POSTGRES_USER=life
POSTGRES_PASSWORD=change-me
POSTGRES_DB=life

# Session signing key (generated by setup-life-game.sh) and the admin login.
# Admin hash: printf '%s\n' "your password" | docker run --rm -i ghcr.io/msvhora/life-game node dist/cli/hash-password.js --stdin
SESSION_SECRET=change-me
ADMIN_PASSWORD_HASH=

# Phone reminders (generated by setup-life-game.sh):
#   docker run --rm ghcr.io/msvhora/life-game node dist/cli/vapid.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://life.yourdomain.com

# Freelance meter, read from your Solidtime (optional; leave empty to keep it off).
# API base, for example https://time.yourdomain.com/api . The token comes from your Solidtime profile.
TIMETRACKER_API_URL=
TIMETRACKER_API_TOKEN=
TIMETRACKER_ORG_ID=

# Nightly database backup to Google Cloud Storage (optional, see backup.sh).
# The key is a service-account JSON, base64 encoded (base64 -w0 key.json). Leave both empty to keep backups local only.
GCS_BACKUP_BUCKET=
GCS_CREDENTIALS_BASE64=
