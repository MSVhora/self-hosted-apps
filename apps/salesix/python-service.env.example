# Salesix python-service (sandbox). Copy to python-service.env and fill in.
# BACKEND_URL=https://api.salesix.ai  (LiveKit Cloud agent uses the same file shape)

# LiveKit Configuration
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Provider API Keys
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
SARVAM_API_KEY=
SONIOX_API_KEY=
CEREBRAS_API_KEY=

# Qdrant Vector Database (for RAG) - Use your cloud Qdrant URL
QDRANT_URL=
QDRANT_API_KEY=

# Python Service API Key (for document processing)
PYTHON_SERVICE_API_KEY=

# Smartflo Bridge Configuration
SMARTFLO_WS_HOST=
SMARTFLO_WS_PORT=
SMARTFLO_ACCOUNT_SID=
SMARTFLO_API_KEY=

# Backend API (for agent lookup)
BACKEND_URL=
INTERNAL_API_KEY=

