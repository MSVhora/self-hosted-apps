# Reference only. scripts/setup-salesix.sh generates these blocks (and the certs)
# through scripts/setup-nginx-domain.sh. Ports match .env.example.
#
#   api.salesix.ai    -> 127.0.0.1:3110  backend
#   app.salesix.ai    -> 127.0.0.1:3111  frontendv2
#   salesix.ai        -> 127.0.0.1:3112  landing
#   www.salesix.ai    -> 301 to https://salesix.ai
#   admin.salesix.ai  -> 127.0.0.1:3113  admin
#   demo.salesix.ai   -> 127.0.0.1:3114  demo
#   pitch.salesix.ai  -> 127.0.0.1:3115  pitch
#   n8n.salesix.ai    -> 127.0.0.1:3116  n8n (long timeouts, websocket upgrade)

server {
    listen 80;
    server_name www.salesix.ai;
    location / {
        return 301 https://salesix.ai$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name api.salesix.ai;

    # ssl_certificate /etc/letsencrypt/live/api.salesix.ai/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/api.salesix.ai/privkey.pem;

    client_max_body_size 20M;

    location / {
        proxy_pass http://127.0.0.1:3110;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 90;
    }
}

server {
    listen 443 ssl http2;
    server_name n8n.salesix.ai;

    # ssl_certificate /etc/letsencrypt/live/n8n.salesix.ai/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/n8n.salesix.ai/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3116;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 600;
        proxy_send_timeout 600;
    }
}
