# Salesix backend (sandbox). Copy to backend.env and fill in. Never commit backend.env.
# This file is also read by the postgres container, so POSTGRES_* must be set.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=salesix

# Same password as REDIS_PASSWORD in .env
REDIS_PASSWORD=change-me

# Sandbox values (the backend reaches the databases by compose service name):
#   NODE_ENV=sandbox
#   PORT=3000
#   DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/salesix?schema=public
#   REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
#   PYTHON_SERVICE_URL=http://python-service:8001
#   PUBLIC_URL=https://api.salesix.ai
#   DOMAIN=app.salesix.ai
#   CORS_ORIGIN=https://app.salesix.ai
#   GOOGLE_REDIRECT_URI=https://app.salesix.ai/settings?tab=integration
#   TWILIO_WEBHOOK_URL=https://api.salesix.ai
# Also set (not in the upstream example): DOMAIN, PUBLIC_URL, CORS_ORIGIN, GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET, GOOGLE_REDIRECT_URI, SENTRY_DSN, NEW_RELIC_* as your backend.env.sandbox has them.

# Environment Configuration
NODE_ENV=
PORT=

# Database
DATABASE_URL=

# Redis
REDIS_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=

# AI Providers
# Deepgram (STT)
DEEPGRAM_API_KEY=

#Sarvam (STT)
SARVAM_API_KEY=

# Google Gemini (LLM)
GEMINI_API_KEY=

# ElevenLabs (TTS) - Premium quality voices
ELEVENLABS_API_KEY=

# OpenAI (for embeddings)
OPENAI_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=

# Smartflo (Tata Tele)
SMARTFLO_ACCOUNT_SID=
SMARTFLO_API_KEY=
SMARTFLO_API_TYPE=

# Vobiz
VOBIZ_API_URL=
VOBIZ_MASTER_ACCOUNT_ID=
VOBIZ_MASTER_AUTH_ID=
VOBIZ_MASTER_AUTH_TOKEN=

# Razorpay
# Explicit Live Credentials
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=
# Test Credentials
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=

# Python Document Processing Service
PYTHON_SERVICE_URL=
PYTHON_SERVICE_API_KEY=

# AWS S3 (Optional - for call recordings)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Feature Flags
ENABLE_CALL_RECORDING=
ENABLE_ANALYTICS=

# LiveKit Cloud Credentials
# Get these from https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit Inbound SIP (for receiving calls)
# Get this from LiveKit Dashboard → SIP → Inbound Trunk → SIP URI
LIVEKIT_INBOUND_SIP_URI=

CARTESIA_API_KEY=

# Email Service (Nodemailer)
# For Gmail, use: smtp.gmail.com, port 587
# You'll need to create an "App Password" in your Google Account settings
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
OTP_EXPIRY_MINUTES=

# SIP Integration for Outbound Calls
# Generate a secure 32+ character random key for encrypting SIP credentials
SIP_CREDENTIALS_ENCRYPTION_KEY=

SYSTEM_CALL_CONCURRENCY_LIMIT=
SYSTEM_RESERVED_INBOUND_SLOTS=

# Demo Room API Configuration
# Public API for creating demo/salesix rooms
ROOM_DEMO_API_KEY=
ROOM_DEMO_ALLOWED_DOMAINS=
ROOM_DEMO_STATIC_USER_EMAIL=
ROOM_DEMO_AGENT_ID=
ROOM_SALESIX_AGENT_ID=
