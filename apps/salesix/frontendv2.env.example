# Salesix frontendv2 runtime env (sandbox). Copy to frontendv2.env.
# NEXT_PUBLIC_* values are baked into the image at build time, not read from here.
# NEXTAUTH_URL=https://app.salesix.ai
# NEXT_INTERNAL_API_URL=http://backend:3000/api
# NEXT_PUBLIC_API_URL=https://api.salesix.ai/api

# NextAuth Configuration
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Backend API Configuration
# Local development (outside Docker)
NEXT_PUBLIC_API_URL=

# Production (inside Docker or deployed)
# NEXT_PUBLIC_API_URL="/api"

# Optional: Email Configuration (SMTP)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_FROM_EMAIL="noreply@yourapp.com"

# Optional: Google OAuth
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Optional: Application Configuration
# NEXT_PUBLIC_APP_NAME="Salesix"
# NEXT_PUBLIC_GOOGLE_MAP_API_KEY="your-google-maps-api-key"

