# Compose-level settings (read by `docker compose` from this file).
# App secrets live in backend.env, python-service.env and frontendv2.env.

# GHCR namespace the images are pushed to (see build-and-push.sh)
GHCR_NAMESPACE=ghcr.io/msvhora
SALESIX_IMAGE_TAG=latest

# Required: also put the SAME value in backend.env (REDIS_PASSWORD and inside REDIS_URL)
REDIS_PASSWORD=change-me

# Loopback ports used by the host nginx
BACKEND_PORT=3110
FRONTEND_PORT=3111
LANDING_PORT=3112
ADMIN_PORT=3113
DEMO_PORT=3114
PITCH_PORT=3115
N8N_PORT=3116
